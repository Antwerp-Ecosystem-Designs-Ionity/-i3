# ƐÏ3 Browser Environment Configuration
# Copy this file to .env and fill in your API keys

# Google CloudSearch API Configuration
# Get your API key from: https://console.cloud.google.com/
GOOGLE_CLOUDSEARCH_API_KEY=your-cloudsearch-api-key-here
CLOUDSEARCH_APP_ID=your-search-application-id-here

# Microsoft Bing Search API (for Edge AI Search)
# Get your API key from: https://portal.azure.com/
BING_SEARCH_API_KEY=your-bing-search-api-key-here

# Note: The browser will work without these keys in simulation mode
# Configure the keys above for full live search functionality
